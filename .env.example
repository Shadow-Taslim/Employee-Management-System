# Generate a long random value; never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=employee_management
# Set to true only when serving the application over HTTPS.
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=0
